.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# ficheros auxiliares que SQLite crea junto al GeoPackage en modo WAL
*.gpkg-wal
*.gpkg-shm
# Excluir el gpkg
*.gpkg
# Excluir herramientas
plantilla_libros.csv
sql/herramientas/*

# Pruebas de conveniencia (CRUD, filtros, mensajes): se conservan en local,
# pero el repo solo versiona el núcleo -> tests/test_esquema.py y test_isbn.py
tests/test_extra.py
# Sidecar de estilo que QGIS deja junto a las capas
*.qmd

# Secretos: claves de API. NUNCA versionar este archivo.
.env
# Bloqueos que deja LibreOffice al abrir un CSV
.~lock.*#

# Volumen compartido con el contenedor (ver Dockerfile): aquí vive el .gpkg.
# El directorio sí se versiona —vacío— porque un bind mount sobre una ruta que
# no existe la crea Docker como root, y entonces el contenedor no puede escribir.
datos/*
!datos/.gitkeep
